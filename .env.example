# Mongo
MONGODB_URI=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — Continue with Google on /auth)
# Create a Web client in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Example local: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — Continue with GitHub on /auth)
# Create an OAuth App under GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
# Example local: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google Gemini (required for interview question generation — all interview types)
GEMINI_API_KEY=
# Primary text model, e.g. gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated fallbacks when the primary hits 429 / quota (same API key)
# GEMINI_MODEL_FALLBACK=gemini-2.5-flash,gemini-1.5-flash
# Diagrams for visual interview questions (same API key)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL_FALLBACK=gemini-2.0-flash-exp

# Deepgram (optional — exact speech-to-text for spoken answers)
# Without it the mic still works, but falls back to the browser's Web Speech
# preview: Chrome-only, no filler words, no pause timings.
# Get a key at https://console.deepgram.com → API Keys
DEEPGRAM_API_KEY=
# Transcription model. nova-3 is the default and supports filler_words.
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en




