# Mongo
MONGODB_URI=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google Gemini (optional — interview question generation falls back to templates if unset)
GEMINI_API_KEY=
# Primary text model, e.g. gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated fallbacks when the primary hits 429 / quota (same API key)
# GEMINI_MODEL_FALLBACK=gemini-2.5-flash,gemini-1.5-flash
# Diagrams for visual interview questions (same API key)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL_FALLBACK=gemini-2.0-flash-exp
